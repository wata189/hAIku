{
  "name": "haiku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "------------↓開発------------": "",
    "ローカルWebサーバ": "vite",
    "ローカルfirebase": "firebase emulators:start --import=emulator_data --export-on-exit",
    "ローカルAPIサーバ": "npx env-cmd -f functions/.env.functions.dev functions-framework --source=functions/main.py --target=entry_point",
    "------------↓バッチ開発------------": "",
    "ローカルバッチ開発": "npx env-cmd -f batch/.env.batch.dev python batch/hoe.py",
    "haiku-data.jpからデータ取得": "npx env-cmd -f batch/.env.batch.dev python batch/fetch_haiku.py",
    "------------↓モジュール------------": "",
    "setGcloudProject": "gcloud config set project haiku-426705",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.16.4",
    "@mui/material": "^5.16.4",
    "axios": "^1.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "firebase-tools": "^13.11.2",
    "globals": "^15.8.0",
    "npx": "^10.2.2",
    "prettier": "^3.3.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.16.1",
    "vite": "^5.2.0"
  }
}
